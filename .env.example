# CalDAV connection settings. When CALDAV_URL is set, it is used and X-Caldav-* request headers are ignored. When unset, requests must provide the X-Caldav-Url, X-Caldav-Username, X-Caldav-Password headers.
CALDAV_URL=https://cloud.gelse.net/remote.php/dav/calendars/werner/
CALDAV_USERNAME=werner
CALDAV_PASSWORD=CHANGE_ME

# Server settings
CALDAV_MCP_PORT=8080
CALDAV_MCP_PATH=/mcp
# Shared secret token. Clients send it as `Authorization: Bearer <token>`
# or `X-Api-Key: <token>`. When unset, authentication is disabled.
CALDAV_MCP_API_KEY=CHANGE_ME

# Read-only mode: hide write tools so only query tools are exposed via MCP
CALDAV_MCP_READ_ONLY=false

# Timezone for "today"/"week" boundaries and date-only inputs (IANA name, e.g. Europe/Vienna)
TZ=Europe/Vienna

# Rate limiting for authentication attempts
CALDAV_MCP_RATE_LIMIT_MAX_FAILURES=10
CALDAV_MCP_RATE_LIMIT_WINDOW_SECONDS=60

# TLS / HTTPS (optional; enables built-in TLS termination)
# When set, the server listens on HTTPS instead of HTTP.
CALDAV_MCP_TLS_CERT=
CALDAV_MCP_TLS_KEY=
# Optional CA bundle for custom certificate authorities
CALDAV_MCP_TLS_CA_BUNDLE=

# CalDAV server SSL verification (set to false only for testing with self-signed certs)
CALDAV_MCP_CALDAV_VERIFY_SSL=true

# Audit log format: "text" (default) or "json"
CALDAV_MCP_LOG_FORMAT=text

# Master secret for encrypting stored CalDAV credentials at rest (SQLite config store).
# Required when the config store is used (pro mode); the CLI encrypts with it,
# the server decrypts on startup. Changing it invalidates stored ciphertexts.
CALDAV_MCP_CONFIG_SECRET=

# Path to the SQLite configuration store (used by the CLI and the pro-mode server).
# The CLI flag --db takes precedence over this env var.
CALDAV_MCP_DB_PATH=

# Pro mode: load config and users from the SQLite store at startup.
# When true, requires both CALDAV_MCP_DB_PATH and CALDAV_MCP_CONFIG_SECRET
# to be set (all three must be provided together).  CALDAV_URL/CALDAV_USERNAME/
# CALDAV_PASSWORD and CALDAV_MCP_API_KEY are ignored in pro mode.
# Clients authenticate with X-Mcp-Username plus Authorization: Bearer <key>
# (or X-Api-Key), and write tools address calendars by the dotted path
# "config.remote.calendar".  Config changes require a server restart.
DB_CONFIG_ENABLED=false
